# Neon Postgres — the products and services catalogue.
# On Vercel, adding the Neon integration sets this for you. Locally, copy the
# connection string from the Neon dashboard (or `vercel env pull`).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Admin dashboard sign-in. Without both of these nobody can sign in.
ADMIN_PASSWORD=""
# 32+ random characters, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=""

# Chatbot widget — iframe src. Exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_CHATBOT_URL="http://localhost:3001"
